{
  "name": "typescript-native",
  "description": "TypeScript 7's built-in language server (tsc --lsp), in place of typescript-language-server, which needs the tsserver.js that TypeScript 7 no longer ships",
  "version": "0.1.0",
  "author": {
    "name": "Collin Van Dyck"
  },
  "lspServers": {
    "typescript": {
      "command": "tsc",
      "args": ["--lsp", "--stdio"],
      "extensionToLanguage": {
        ".ts": "typescript",
        ".tsx": "typescriptreact",
        ".js": "javascript",
        ".jsx": "javascriptreact",
        ".mts": "typescript",
        ".cts": "typescript",
        ".mjs": "javascript",
        ".cjs": "javascript"
      }
    }
  }
}
