{
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash(awk:*)",
      "Bash(bash:*)",
      "Bash(cat:*)",
      "Bash(cds/cmd/wal-admin/*)",
      "Bash(chmod:*)",
      "Bash(docker:*)",
      "Bash(done)",
      "Bash(echo:*)",
      "Bash(find:*)",
      "Bash(gh:*)",
      "Bash(git:*)",
      "Bash(go:*)",
      "Bash(golangci-lint:*)",
      "Bash(grep:*)",
      "Bash(ls)",
      "Bash(make:*)",
      "Bash(mise run:*)",
      "Bash(obsidian:*)",
      "Bash(open:*)",
      "Bash(pip install:*)",
      "Bash(pip3 install:*)",
      "Bash(playwright install:*)",
      "Bash(python3:*)",
      "Bash(sed)",
      "Bash(sem:*)",
      "Bash(sort)",
      "Bash(sqlite3:*)",
      "Bash(tee)",
      "Bash(unset:*)",
      "Bash(wc)",
      "Bash(xargs:*)",
      "Bash(xxd:*)",
      "Skill(cds:rework-commits)",
      "Skill(cds:wal-admin)",
      "Skill(greetings)",
      "Skill(playwright)",
      "Skill(wal-admin)",
      "WebFetch(domain:berthub.eu)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:riverqueue.com)",
      "WebSearch",
      "mcp__notion__notion-fetch"
    ],
    "deny": [],
    "ask": [],
    "defaultMode": "auto",
    "additionalDirectories": [
      "~/code/temporal",
      "~/code/bookkeeper",
      "~/code",
      "~/Downloads",
      "/tmp/",
      "~/go/pkg/mod"
    ]
  },
  "model": "claude-opus-5-5[1m]",
  "skillOverrides": {
    "ch-cell-query": "off",
    "cell-metrics-query": "off"
  },
  "hooks": {
    "PreToolUse": [],
    "SessionStart": [],
    "UserPromptSubmit": [],
    "Stop": []
  },
  "statusLine": {
    "type": "command",
    "command": "claude-statusline",
    "refreshInterval": 5
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "gopls-lsp@claude-plugins-official": true,
    "lua-lsp@claude-plugins-official": true,
    "mcp-server-dev@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "superpowers@superpowers-marketplace": true,
    "typescript-lsp@claude-plugins-official": true,
    "temporal@temporal-marketplace": true
  },
  "extraKnownMarketplaces": {
    "temporal-marketplace": {
      "source": {
        "source": "github",
        "repo": "temporalio/agent-skills"
      }
    }
  },
  "effortLevel": "high",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "high"
    },
    "claude-sonnet-5-5": {
      "autoCompactWindow": 250000
    }
  },
  "autoMemoryEnabled": false,
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "theme": "custom:collin",
  "preferredNotifChannel": "ghostty",
  "skipAutoPermissionPrompt": true
}
