#!/usr/bin/env bash
set -euo pipefail

# sets up the standard operating environment for claude.
# explicitly a bash script to avoid inheriting aliases for things like lsd.

# use bash for claude code sessions
export CLAUDE_CODE_SHELL=bash
# instruct claude to pick up system prompts in added directories
export CLAUDE_CODE_ADDITIONAL_DIRECTORIES_CLAUDE_MD=1

export CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY=1
export CLAUDE_CODE_NO_FLICKER=1
export CLAUDE_CODE_SCROLL_SPEED=1
export CLAUDE_CODE_ENABLE_TODO_TOOLS=1

CLAUDE=~/.local/bin/claude
[[ ! -e "${CLAUDE:-}" ]] && {
	echo "Installing claude..."
	curl -fsSL https://claude.ai/install.sh | bash
}

args=(--ide)
mixins=(~/code/temporal)

# subcommands that manage claude rather than start a session. parsed from `claude -h` and cached per installed
# version. some subcommands are hidden from help, so they're listed explicitly.
subcommands() {
	local version cache
	version=$(basename "$(readlink "$CLAUDE" || echo "$CLAUDE")")
	cache=~/.cache/claude-wrapper/subcommands-$version
	if [[ ! -s "$cache" ]]; then
		mkdir -p "$(dirname "$cache")"
		$CLAUDE -h 2>/dev/null | awk '/^Commands:/ { f = 1; next } f && /^  [a-z]/ { gsub(/\|/, "\n", $1); print $1 }' >"$cache"
	fi
	command cat "$cache"
	printf '%s\n' daemon project help -h --help -v --version
}

if [[ $# -gt 0 ]] && grep -qxF -- "$1" <<<"$(subcommands)"; then
	exec $CLAUDE "$@"
fi

for mixin in "${mixins[@]}"; do
	if [[ -d "$mixin" ]]; then
		args+=("--add-dir" "$mixin")
	fi
done

exec $CLAUDE "${args[@]}" "$@"
